<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RoundsModkit.Launcher.ViewModels"
        x:Class="RoundsModkit.Launcher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ROUNDS Modkit" Width="980" Height="680" MinWidth="720" MinHeight="480">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Height="110" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <ScrollViewer>
        <SelectableTextBlock Text="{Binding Log}" FontFamily="monospace" FontSize="12" Margin="10,6" />
      </ScrollViewer>
    </Border>

    <TabControl Margin="8" SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="Game">
        <StackPanel Spacing="12" Margin="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding GameDir}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="700" />
            <Button Content="Browse…" Command="{Binding BrowseCommand}" />
          </StackPanel>

          <TextBlock Text="{Binding BranchText}" Classes.warn="{Binding !BranchOk}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding BepInExText}" />

          <Border IsVisible="{Binding ProtonOverrideMissing}" Padding="10" CornerRadius="6"
                  Background="#33E0A030">
            <StackPanel Spacing="6">
              <TextBlock FontWeight="SemiBold" Text="Linux: Steam launch options needed so BepInEx loads under Proton" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Steam → ROUNDS → Properties → General → Launch Options. Steam writes this to disk when it saves its config, so Refresh may lag a little." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <SelectableTextBlock Text="{Binding ProtonLaunchOptions}" FontFamily="monospace" VerticalAlignment="Center" />
                <Button Content="Copy" Command="{Binding CopyLaunchOptionsCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding HasGame}">
            <Button Content="Launch ROUNDS" Classes="accent" Command="{Binding LaunchCommand}" />
            <Button Content="Install / repair BepInEx" Command="{Binding InstallBepInExCommand}" IsEnabled="{Binding !Busy}" />
            <Button Content="Remove BepInEx" Command="{Binding UninstallBepInExCommand}" IsEnabled="{Binding BepInExInstalled}" />
            <Button Content="Open game folder" Command="{Binding OpenGameFolderCommand}" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
          </StackPanel>
        </StackPanel>
      </TabItem>

      <TabItem Header="Browse">
        <Grid ColumnDefinitions="*,360" RowDefinitions="Auto,*,Auto" Margin="8" DataContext="{Binding Browser}" x:DataType="vm:BrowserViewModel">
          <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBox Text="{Binding SearchText}" Watermark="Search mods…" Width="320" />
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" MinWidth="170" />
            <CheckBox Content="Show deprecated" IsChecked="{Binding IncludeDeprecated}" />
            <Button Content="Reload list" Command="{Binding ReloadCommand}" IsEnabled="{Binding !Loading}" />
          </StackPanel>

          <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BrowserItemViewModel">
                <Grid ColumnDefinitions="48,*,Auto">
                  <Image Source="{Binding Icon}" Width="48" Height="48" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock>
                      <Run Text="{Binding Name}" FontWeight="SemiBold" />
                      <Run Text="{Binding Owner}" Foreground="Gray" FontSize="12" />
                    </TextBlock>
                    <TextBlock Text="{Binding Description}" FontSize="12" Classes="muted" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" Foreground="#3FA34D" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
            <StackPanel Spacing="8" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Image Source="{Binding Selected.Icon}" Width="128" Height="128" HorizontalAlignment="Left"
                     IsVisible="{Binding Selected.Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Text="{Binding Selected.Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Selected.Owner}" Classes="muted" />
              <TextBlock Text="{Binding Selected.Meta}" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Selected.CategoriesText}" FontSize="12" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Selected.Description}" TextWrapping="Wrap" />
              <StackPanel IsVisible="{Binding Selected.HasDependencies}" Spacing="2">
                <TextBlock Text="Requires" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Selected.Dependencies}" />
              </StackPanel>
              <TextBlock Text="{Binding Selected.StatusText}" Foreground="#3FA34D" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding Selected.ActionText}" Classes="accent"
                        Command="{Binding Selected.InstallCommand}" IsEnabled="{Binding !Installing}" />
                <Button Content="Thunderstore page" Command="{Binding Selected.OpenPageCommand}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Status}" Classes="muted" Margin="0,8,0,0" />
        </Grid>
      </TabItem>

      <TabItem Header="Presets">
        <Grid ColumnDefinitions="280,*" RowDefinitions="*,Auto" Margin="8" DataContext="{Binding Presets}" x:DataType="vm:PresetsViewModel">
          <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
              <TextBlock Text="Save current mods as a preset" FontWeight="SemiBold" />
              <TextBox Text="{Binding NewName}" Watermark="Preset name" />
              <TextBox Text="{Binding NewDescription}" Watermark="Description (optional)" />
              <WrapPanel>
                <Button Content="Save…" Command="{Binding SaveCurrentCommand}" Margin="0,0,6,6" />
                <Button Content="Import…" Command="{Binding ImportCommand}" Margin="0,0,6,6" />
                <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="0,0,6,6" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding !Busy}" Margin="0,0,6,6" />
              </WrapPanel>
            </StackPanel>
            <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Selected}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PresetItemViewModel">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SourceText}" FontSize="11" Classes="muted" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <ScrollViewer Grid.Column="1" Margin="12,0,0,0">
            <StackPanel Spacing="8" DataContext="{Binding Selected}" x:DataType="vm:PresetItemViewModel"
                        IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SourceText}" Classes="muted" />
              <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                         IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="{Binding ModeText}" FontSize="12" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="Mods" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding ModLines}" />
              <TextBlock Text="{Binding PlanText}" Foreground="#3FA34D" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Apply preset" Classes="accent"
                        Command="{Binding $parent[ScrollViewer].((vm:PresetsViewModel)DataContext).ApplyCommand}"
                        IsEnabled="{Binding !$parent[ScrollViewer].((vm:PresetsViewModel)DataContext).Busy}" />
                <Button Content="Delete" IsVisible="{Binding IsLocal}"
                        Command="{Binding $parent[ScrollViewer].((vm:PresetsViewModel)DataContext).DeleteCommand}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Status}" Classes="muted" Margin="0,8,0,0" />
        </Grid>
      </TabItem>

      <TabItem Header="Mods">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8" IsEnabled="{Binding HasGame}">
            <Button Content="Import .zip / .dll…" Command="{Binding ImportModCommand}" />
            <Button Content="Open plugins folder" Command="{Binding OpenPluginsFolderCommand}" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" Classes="muted" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="Unchecked mods are moved to BepInEx/plugins-disabled so BepInEx skips them. Download ROUNDS mods from thunderstore.io/c/rounds." />
          <ListBox ItemsSource="{Binding Mods}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModItemViewModel">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <CheckBox IsChecked="{Binding IsEnabled}" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Details}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="760" />
                    <TextBlock Text="{Binding MissingDependencies}" Classes="warn" FontSize="12"
                               IsVisible="{Binding MissingDependencies, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

      <TabItem Header="Config">
        <Grid ColumnDefinitions="260,*" Margin="8">
          <ListBox Grid.Column="0" ItemsSource="{Binding Configs}" SelectedItem="{Binding SelectedConfig}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ConfigFileViewModel">
                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <DockPanel Grid.Column="1" Margin="12,0,0,0" DataContext="{Binding SelectedConfig}" x:DataType="vm:ConfigFileViewModel"
                     IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
              <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Content="Save" Classes="accent" Command="{Binding SaveCommand}" IsEnabled="{Binding Dirty}" />
              <Button Content="Revert" Command="{Binding ReloadCommand}" IsEnabled="{Binding Dirty}" />
            </StackPanel>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConfigEntryViewModel">
                    <Grid ColumnDefinitions="*,280" Margin="0,0,12,12">
                      <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock>
                          <Run Text="{Binding Section}" Foreground="Gray" />
                          <Run Text=" / " Foreground="Gray" />
                          <Run Text="{Binding Key}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12"
                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{Binding Hint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                      <Panel Grid.Column="1" VerticalAlignment="Top">
                        <CheckBox IsVisible="{Binding IsBoolean}" IsChecked="{Binding BoolValue}" />
                        <ComboBox IsVisible="{Binding IsChoice}" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" HorizontalAlignment="Stretch" />
                        <TextBox IsVisible="{Binding IsText}" Text="{Binding Value}" />
                      </Panel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
